CREATE TABLE player_characters (
    id TEXT NOT NULL PRIMARY KEY,
    campaign_id TEXT NOT NULL,
    owner_user_id TEXT NOT NULL,
    race_id TEXT NOT NULL,
    background_id TEXT NOT NULL,
    name TEXT NOT NULL,
    level INTEGER NOT NULL DEFAULT 1,
    hp_current INTEGER NOT NULL,
    hp_max INTEGER NOT NULL,
    str INTEGER NOT NULL,
    dex INTEGER NOT NULL,
    con INTEGER NOT NULL,
    intelligence INTEGER NOT NULL,
    wis INTEGER NOT NULL,
    cha INTEGER NOT NULL,
    is_custom_content INTEGER NOT NULL DEFAULT 0,
    pending_dm_approval INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (campaign_id) REFERENCES player_campaigns(id)
);

CREATE TABLE player_character_classes (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL,
    class_id TEXT NOT NULL,
    level INTEGER NOT NULL DEFAULT 1,
    is_primary INTEGER NOT NULL DEFAULT 0,
    approved_by_dm INTEGER NOT NULL DEFAULT 0,
    requested_at INTEGER NOT NULL,
    approved_at INTEGER,
    FOREIGN KEY (character_id) REFERENCES player_characters(id)
);

CREATE TABLE player_character_ability_choices (
    id TEXT NOT NULL PRIMARY KEY,
    character_id TEXT NOT NULL,
    ability_id TEXT NOT NULL,
    bonus_amount INTEGER NOT NULL,
    FOREIGN KEY (character_id) REFERENCES player_characters(id)
);

insertCharacter:
INSERT INTO player_characters(id, campaign_id, owner_user_id, race_id, background_id, name, level, hp_current, hp_max, str, dex, con, intelligence, wis, cha, is_custom_content, pending_dm_approval)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCharactersByOwner:
SELECT * FROM player_characters WHERE owner_user_id = ?;

selectCharactersByCampaign:
SELECT * FROM player_characters WHERE campaign_id = ?;

selectPendingApproval:
SELECT * FROM player_characters WHERE campaign_id = ? AND pending_dm_approval = 1;

updateCharacterStats:
UPDATE player_characters
SET hp_current = ?, str = ?, dex = ?, con = ?, intelligence = ?, wis = ?, cha = ?
WHERE id = ?;

approveCharacterChanges:
UPDATE player_characters SET pending_dm_approval = 0 WHERE id = ?;

insertPrimaryClass:
INSERT INTO player_character_classes(id, character_id, class_id, level, is_primary, approved_by_dm, requested_at, approved_at)
VALUES (?, ?, ?, ?, 1, 1, ?, ?);

requestMulticlass:
INSERT INTO player_character_classes(id, character_id, class_id, level, is_primary, approved_by_dm, requested_at, approved_at)
VALUES (?, ?, ?, ?, 0, 0, ?, NULL);

approveMulticlass:
UPDATE player_character_classes SET approved_by_dm = 1, approved_at = ? WHERE id = ?;

selectClassesForCharacter:
SELECT * FROM player_character_classes WHERE character_id = ?;

selectPendingMulticlassRequests:
SELECT * FROM player_character_classes WHERE approved_by_dm = 0;

insertAbilityChoice:
INSERT INTO player_character_ability_choices(id, character_id, ability_id, bonus_amount)
VALUES (?, ?, ?, ?);

selectAbilityChoicesForCharacter:
SELECT * FROM player_character_ability_choices WHERE character_id = ?;

selectCharacterById:
SELECT * FROM player_characters WHERE id = ?;

updatePlayerCharacterHp:
UPDATE player_characters SET hp_current = ?, pending_dm_approval = 1 WHERE id = ?;