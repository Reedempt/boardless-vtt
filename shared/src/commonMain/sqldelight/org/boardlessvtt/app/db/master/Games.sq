CREATE TABLE master_games (
    id TEXT NOT NULL PRIMARY KEY,
    code TEXT NOT NULL UNIQUE,              -- 'dnd5e', 'pathfinder2e'
    name TEXT NOT NULL,
    rules_pack_version TEXT,
    rules_pack_size_bytes INTEGER,
    is_installed INTEGER NOT NULL DEFAULT 0, -- SQLite boolean = INTEGER 0/1
    local_pack_path TEXT,                    -- path al file .db scaricato/importato
    download_url TEXT
);

insertGame:
INSERT INTO master_games(id, code, name, rules_pack_version, rules_pack_size_bytes, is_installed, local_pack_path, download_url)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectAllGames:
SELECT * FROM master_games;

selectInstalledGames:
SELECT * FROM master_games WHERE is_installed = 1;

markGameInstalled:
UPDATE master_games SET is_installed = 1, local_pack_path = ? WHERE id = ?;